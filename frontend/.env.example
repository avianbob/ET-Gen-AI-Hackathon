# Backend API base URL (no trailing slash)
VITE_API_URL=http://localhost:8000

# Optional: Google Maps JavaScript API key for plant location map
# Get key from Google Cloud Console; enable "Maps JavaScript API".
# Restrict key by HTTP referrer (e.g. http://localhost:5173/*, https://yourdomain.com/*).
# If omitted, the plant locations list still appears but the map will show a setup message.
# VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
