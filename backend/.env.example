# Server
FRONTEND_URL=http://localhost:5173

# LLM: at least one required (no dummy responses; real API only)
# Primary: Google Gemini (recommended). Do not use gemini-pro (removed by Google API).
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Fallback when Gemini fails (404 deprecated model, 429, network): Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Repurpose (bundled): drug search, chat, exports, ChromaDB — uses GEMINI_API_KEY via LangChain.
# Optional MongoDB: USE_MONGODB=true and MONGODB_URI
# PDF export: playwright install chromium

# Supabase (optional): run database/supabase/001_schema.sql then 002_seed.sql in the SQL Editor.
# Use Project URL + anon/publishable key for SUPABASE_KEY, or service_role in SUPABASE_SERVICE_ROLE_KEY for admin (bypasses RLS).
# Dotenv rules: KEY=value only — no spaces around =, no semicolons at end of line, no SQL/JS-style quotes+;
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_KEY=your_publishable_or_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
